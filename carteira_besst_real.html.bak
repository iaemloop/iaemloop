<!DOCTYPE html>
<html><head><meta charset="UTF-8">
<title>BESST</title>
<style>
:root{--bg:#0c1016;--card:#141820;--gold:#d4af37;--green:#22c55e;--text:#fff;--text2:#8b92a8;--border:#1e2330}
.bg-img{position:fixed;top:0;left:0;width:100%;height:100%;z-index:-1;opacity:0.08;background:url("assets/bg-carteiras.jpg") center/cover no-repeat;pointer-events:none}
body{font-family:system-ui;background:var(--bg);color:var(--text);padding:24px;margin:0}
.container{max-width:1400px;margin:0 auto}
.back{position:fixed;top:20px;left:20px;background:var(--card);color:var(--gold);padding:10px 16px;border-radius:8px;text-decoration:none;z-index:1000}
h1{color:var(--gold);font-size:32px;margin:0}
p.sub{color:var(--text2);margin-top:6px}
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:32px}
.kpi{background:var(--card);padding:20px;border-radius:12px;transition:all .3s}
.kpi:hover{transform:translateY(-2px);box-shadow:0 8px 32px rgba(212,175,55,.2)}
.kpi-val{font-size:28px;font-weight:600;color:var(--gold)}
.charts-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:32px}
.chart-box{background:var(--card);border-radius:16px;padding:32px}
.chart-title{color:var(--gold);font-size:18px;margin-bottom:24px}
.chart-flex{display:flex;align-items:center;gap:32px}
.donut{position:relative;width:180px;height:180px;border-radius:50%;flex-shrink:0}
.donut::after{content:"";position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:120px;height:120px;background:var(--card);border-radius:50%}
.donut-center{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;z-index:1}
.donut-val{font-size:24px;font-weight:700;color:var(--gold)}
.legend{flex:1}
.legend-row{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border)}
.legend-info{display:flex;align-items:center;gap:10px}
.legend-dot{width:12px;height:12px;border-radius:50%}
.legend-tick{font-size:15px;font-weight:600}
.legend-sec{font-size:12px;color:var(--text2)}
.legend-pct{font-size:16px;font-weight:700;color:var(--gold)}
.sec-row{display:flex;align-items:center;padding:10px 0;border-bottom:1px solid var(--border)}
.sec-info{display:flex;align-items:center;gap:10px}
.sec-bar{flex:1;height:6px;background:var(--bg);border-radius:3px;margin:0 12px}
.sec-pct{font-size:15px;font-weight:700;color:var(--gold);min-width:50px;text-align:right}
.custodia-wrap{background:var(--card);border-radius:16px;padding:32px;margin-bottom:32px;border-left:4px solid var(--green)}
.custodia-title{color:var(--green);font-size:20px;margin-bottom:24px}
.custodia-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:16px}
.custodia-item{background:var(--card);padding:20px;border-radius:12px;border-left:4px solid var(--gold)}
.custodia-tick{font-size:20px;font-weight:700;margin-bottom:8px}
.custodia-info{font-size:14px;color:var(--text2)}
.custodia-valor{font-size:18px;font-weight:700;color:var(--gold);margin-top:12px}
.proventos-wrap{background:var(--card);border-radius:16px;padding:32px;margin:32px 0;border-left:4px solid #9b59b6}
.proventos-title{color:#9b59b6;font-size:20px;margin-bottom:16px}
.proventos-total{font-size:32px;font-weight:700;color:var(--gold)}
footer{text-align:center;padding:40px;color:var(--text2);border-top:1px solid var(--border);margin-top:40px}
@media(max-width:1000px){.charts-grid{grid-template-columns:1fr}}
@media(max-width:900px){.kpis{grid-template-columns:repeat(2,1fr)}.chart-flex{flex-direction:column}}
</style>
</head>
<body><div class="bg-img"></div>
<a href="javascript:history.back()" class="back">← Voltar</a>
<div class="container">
<header><h1>💎 Carteira BESST</h1><p class="sub">Método Barsi + Buffett</p></header>

<div class="kpis">
<div class="kpi"><div class="kpi-val">R$ 577,24</div><div class="kpi-lab">Valor Total</div></div>
<div class="kpi"><div class="kpi-val" style="color:var(--green)">R$ 0,55</div><div class="kpi-lab">Proventos 2026</div></div>
<div class="kpi"><div class="kpi-val">R$ 82,46</div><div class="kpi-lab">Ticket Médio</div></div>
<div class="kpi"><div class="kpi-val">7</div><div class="kpi-lab">Posições</div></div>
</div>

<div class="charts-grid">

<div class="chart-box">
<div class="chart-title">📊 Distribuição por Ativo</div>
<div class="chart-flex">
<div class="donut" style="background:conic-gradient(var(--gold) 0deg 81deg,#e74c3c 81deg 148deg,#1abc9c 148deg 212deg,#3498db 212deg 268deg,#2ecc71 268deg 316deg,#f39c12 316deg 346deg,#95a5a6 346deg 360deg)"><div class="donut-center"><div class="donut-val">R$577</div></div></div>
<div class="legend">
<div class="legend-row"><div class="legend-info"><div class="legend-dot" style="background:var(--gold)"></div><span class="legend-tick">TAEE11</span><span class="legend-sec">Energia</span></div><span class="legend-pct">22,5%</span></div>
<div class="legend-row"><div class="legend-info"><div class="legend-dot" style="background:#e74c3c"></div><span class="legend-tick">CSMG3</span><span class="legend-sec">Saneamento</span></div><span class="legend-pct">18,7%</span></div>
<div class="legend-row"><div class="legend-info"><div class="legend-dot" style="background:#1abc9c"></div><span class="legend-tick">PSSA3</span><span class="legend-sec">Seguros</span></div><span class="legend-pct">17,9%</span></div>
<div class="legend-row"><div class="legend-info"><div class="legend-dot" style="background:#3498db"></div><span class="legend-tick">SAPR11</span><span class="legend-sec">Saneamento</span></div><span class="legend-pct">15,4%</span></div>
<div class="legend-row"><div class="legend-info"><div class="legend-dot" style="background:#2ecc71"></div><span class="legend-tick">BRSR6</span><span class="legend-sec">Bancos</span></div><span class="legend-pct">9,6%</span></div>
<div class="legend-row"><div class="legend-info"><div class="legend-dot" style="background:#f39c12"></div><span class="legend-tick">BMGB4</span><span class="legend-sec">Bancos</span></div><span class="legend-pct">8,6%</span></div>
<div class="legend-row"><div class="legend-info"><div class="legend-dot" style="background:#95a5a6"></div><span class="legend-tick">CPLE3</span><span class="legend-sec">Energia</span></div><span class="legend-pct">7,5%</span></div>
</div>
</div>
</div>

<div class="chart-box">
<div class="chart-title">🏭 Alocação por Setor</div>
<div class="chart-flex" style="flex-direction:column">
<div class="donut" style="background:conic-gradient(#e74c3c 0deg 123deg,var(--gold) 123deg 231deg,#1abc9c 231deg 297deg,#3498db 297deg 360deg)"><div class="donut-center"><div class="donut-val">4</div></div></div>
<div style="width:100%">
<div class="sec-row"><div class="sec-info"><div class="legend-dot" style="background:#e74c3c"></div><span class="legend-tick">Saneamento</span></div><div class="sec-bar"><div style="width:100%;height:100%;background:#e74c3c;border-radius:3px"></div></div><span class="sec-pct">34,1%</span></div>
<div class="sec-row"><div class="sec-info"><div class="legend-dot" style="background:var(--gold)"></div><span class="legend-tick">Energia</span></div><div class="sec-bar"><div style="width:88%;height:100%;background:var(--gold);border-radius:3px"></div></div><span class="sec-pct">30,0%</span></div>
<div class="sec-row"><div class="sec-info"><div class="legend-dot" style="background:#3498db"></div><span class="legend-tick">Bancos</span></div><div class="sec-bar"><div style="width:53%;height:100%;background:#3498db;border-radius:3px"></div></div><span class="sec-pct">18,2%</span></div>
<div class="sec-row"><div class="sec-info"><div class="legend-dot" style="background:#1abc9c"></div><span class="legend-tick">Seguros</span></div><div class="sec-bar"><div style="width:52%;height:100%;background:#1abc9c;border-radius:3px"></div></div><span class="sec-pct">17,9%</span></div>
</div>
</div>
</div>
</div>

<div class="custodia-wrap">
<div class="custodia-title">📊 Ações em Custódia</div>
<div class="custodia-grid">
<div class="custodia-item" style="border-left-color:var(--gold)"><div class="custodia-tick" style="color:var(--gold)">TAEE11</div><div class="custodia-info">Taesa • Energia</div><div class="custodia-info">3 unidades × R$ 43,23</div><div class="custodia-valor">R$ 129,69</div></div>
<div class="custodia-item" style="border-left-color:#e74c3c"><div class="custodia-tick" style="color:#e74c3c">CSMG3</div><div class="custodia-info">Copasa • Saneamento</div><div class="custodia-info">2 unidades × R$ 53,83</div><div class="custodia-valor">R$ 107,66</div></div>
<div class="custodia-item" style="border-left-color:#1abc9c"><div class="custodia-tick" style="color:#1abc9c">PSSA3</div><div class="custodia-info">Porto Seguro • Seguros</div><div class="custodia-info">2 unidades × R$ 51,65</div><div class="custodia-valor">R$ 103,30</div></div>
<div class="custodia-item" style="border-left-color:#3498db"><div class="custodia-tick" style="color:#3498db">SAPR11</div><div class="custodia-info">Sanepar • Saneamento</div><div class="custodia-info">2 unidades × R$ 44,33</div><div class="custodia-valor">R$ 88,66</div></div>
<div class="custodia-item" style="border-left-color:#2ecc71"><div class="custodia-tick" style="color:#2ecc71">BRSR6</div><div class="custodia-info">Banrisul • Bancos</div><div class="custodia-info">3 unidades × R$ 18,41</div><div class="custodia-valor">R$ 55,23</div></div>
<div class="custodia-item" style="border-left-color:#f39c12"><div class="custodia-tick" style="color:#f39c12">BMGB4</div><div class="custodia-info">BMG • Bancos</div><div class="custodia-info">10 unidades × R$ 4,95</div><div class="custodia-valor">R$ 49,50</div></div>
<div class="custodia-item" style="border-left-color:#95a5a6"><div class="custodia-tick" style="color:#95a5a6">CPLE3</div><div class="custodia-info">Copel • Energia</div><div class="custodia-info">3 unidades × R$ 14,40</div><div class="custodia-valor">R$ 43,20</div></div>
</div>
</div>

<div class="proventos-wrap">
<div class="proventos-title">💰 Proventos Recebidos</div>
<div class="proventos-total">R$ 0,55</div>
<div class="proventos-mes">Março de 2026</div>
<div class="proventos-row"><span>BRSR6 - Juros Sobre Capital Próprio</span><span class="proventos-valor">R$ 0,55</span></div>
</div>

<footer>🦞 Carteira BESST | iaemloop.com.br</footer>
</div>
</body>
</html>